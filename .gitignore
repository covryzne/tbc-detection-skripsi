# Ignore semua isi dalam TB_Chest_Radiography_Database 
dataset/
!dataset\README.MD

# Ignore file kredensial Kaggle
kaggle.json

# Ignore file environment dan dependencies
venv/
.env

# Ignore cache dan file sementara
__pycache__/
*.pyc
*.pyo

# Ignore log dan hasil build
*.log
*.out
*.h5
*.ckpt

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore frontend dependencies (jika pakai React/Vue)
node_modules/
dist/

# Ignore IDE dan editor settings
.vscode/
.idea/
*.swp


